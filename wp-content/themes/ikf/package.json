{
	"name": "ikf",
	"version": "1.0.0",
	"description": "IKF WordPress theme",
	"author": "chowfun",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"Theme"
	],
	"private": true,
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.2.3"
	},
	"devDependencies": {
		"@wordpress/browserslist-config": "^6.34.0",
		"concurrently": "^9.2.1",
		"cssnano": "^7.1.2",
		"esbuild": "^0.25.9",
		"postcss": "^8.5.6",
		"postcss-cli": "^11.0.1",
		"sass": "^1.90.0"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"scripts": {
		"build:css": "sass src/scss/main.scss:assets/css/main.css --style=expanded --no-source-map && postcss assets/css/main.css --use cssnano -o assets/css/main.min.css --no-map",
		"build:js": "esbuild src/js/main.js --bundle --outfile=assets/js/main.js && esbuild src/js/main.js --bundle --minify --outfile=assets/js/main.min.js",
		"build:style": "postcss style.css --use cssnano -o style.min.css --no-map",
		"build": "npm run build:css && npm run build:js && npm run build:style",
		"watch:css": "sass src/scss/main.scss:assets/css/main.css --watch --style=expanded --source-map",
		"watch:css:min": "postcss assets/css/main.css --use cssnano -o assets/css/main.min.css --no-map --watch",
		"watch:js": "esbuild src/js/main.js --bundle --outfile=assets/js/main.js --sourcemap --watch",
		"watch:js:min": "esbuild src/js/main.js --bundle --minify --outfile=assets/js/main.min.js --watch",
		"watch": "concurrently -n css,cssmin,js,jsmin -c blue,cyan,green,yellow \"npm:watch:css\" \"npm:watch:css:min\" \"npm:watch:js\" \"npm:watch:js:min\""
	}
}
